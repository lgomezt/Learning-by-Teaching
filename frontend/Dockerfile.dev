# Development Dockerfile for frontend (with hot reload)
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (will be overridden by volume, but ensures npm is available)
RUN npm ci

# Expose Vite dev server port
EXPOSE 5173

# Use a shell command to ensure npm is available and install deps if needed
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
